#!/bin/bash

set -euo pipefail

installed_app="/Library/Input Methods/windwhisper.app"
installed_binary="$installed_app/Contents/MacOS/windwhisper"
lsregister="/System/Library/Frameworks/CoreServices.framework/Frameworks/LaunchServices.framework/Support/lsregister"

if [[ ! -x "$installed_binary" ]]; then
    echo "Installed windwhisper executable is missing." >&2
    exit 1
fi

"$lsregister" -f "$installed_app"

console_user="$(/usr/bin/stat -f '%Su' /dev/console)"
if [[ "$console_user" != "root" && "$console_user" != "loginwindow" ]]; then
    console_uid="$(/usr/bin/id -u "$console_user")"
    /bin/launchctl asuser "$console_uid" \
        /usr/bin/sudo -u "$console_user" \
        "$installed_binary" --register-input-source \
        >/dev/null 2>&1 || true
fi

/usr/bin/killall imklaunchagent >/dev/null 2>&1 || true
/usr/bin/killall TextInputMenuAgent >/dev/null 2>&1 || true
/usr/bin/killall -9 TextInputSwitcher >/dev/null 2>&1 || true

if [[ "$console_user" != "root" && "$console_user" != "loginwindow" ]]; then
    /bin/launchctl asuser "$console_uid" \
        /bin/launchctl kickstart -k "gui/$console_uid/com.apple.imklaunchagent" \
        >/dev/null 2>&1 || true
fi

exit 0
