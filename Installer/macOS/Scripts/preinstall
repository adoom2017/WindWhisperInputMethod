#!/bin/bash

set -euo pipefail

installed_app="/Library/Input Methods/windwhisper.app"
installed_binary="$installed_app/Contents/MacOS/windwhisper"
fallback_input_source="com.apple.keylayout.ABC"
lsregister="/System/Library/Frameworks/CoreServices.framework/Frameworks/LaunchServices.framework/Support/lsregister"

console_user="$(/usr/bin/stat -f '%Su' /dev/console)"
if [[ "$console_user" != "root" && "$console_user" != "loginwindow" ]]; then
    console_uid="$(/usr/bin/id -u "$console_user")"
    if [[ -x "$installed_binary" ]]; then
        /bin/launchctl asuser "$console_uid" \
            /usr/bin/sudo -u "$console_user" \
            "$installed_binary" --select-input-source-id "$fallback_input_source" \
            >/dev/null 2>&1 || true
    fi
fi

if [[ -d "$installed_app" ]]; then
    "$lsregister" -u "$installed_app" >/dev/null 2>&1 || true
fi

# The active input source may briefly restart while macOS processes the
# fallback selection. Stop it repeatedly before Installer replaces the bundle.
for _ in {1..20}; do
    if ! /usr/bin/pgrep -x windwhisper >/dev/null 2>&1; then
        break
    fi
    /usr/bin/pkill -x windwhisper >/dev/null 2>&1 || true
    /bin/sleep 0.25
done

if /usr/bin/pgrep -x windwhisper >/dev/null 2>&1; then
    /usr/bin/pkill -9 -x windwhisper >/dev/null 2>&1 || true
    /bin/sleep 0.25
fi

if /usr/bin/pgrep -x windwhisper >/dev/null 2>&1; then
    echo "Unable to stop the running windwhisper input method." >&2
    exit 1
fi

exit 0
